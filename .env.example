# ============================================================
# VOYAGIO environment variables (copy to .env and customize)
# ============================================================

# --- Backend ---
BACKEND_PORT=8080

# JWT signing secret (CHANGE THIS in production - must be >= 32 chars)
JWT_SECRET=TripWithUsSuperSecretKeyForJWTSigning2026ChangeInProduction!!

# JWT token lifetime in milliseconds (default 24h)
JWT_EXPIRATION_MS=86400000

# Admin bootstrap credentials
ADMIN_USERNAME=joo
ADMIN_PASSWORD=joo@123

# --- Database (defaults to in-memory H2) ---
DB_USERNAME=sa
DB_PASSWORD=
DB_DDL_AUTO=create-drop
